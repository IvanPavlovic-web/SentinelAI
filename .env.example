# Copy to .env and adjust as needed. Used by docker-compose and local dev.

# --- App ---
ENV=development
DEBUG=true

# --- Database (docker-compose service name "postgres") ---
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@postgres:5432/sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# --- Auth / JWT ---
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis / Celery (docker-compose service name "redis") ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Number of concurrent worker subprocesses per celery_worker container.
# Scale this (and/or run multiple celery_worker replicas) to match camera
# count / expected concurrent uploads for a large deployment.
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=21600
CELERY_TASK_TIME_LIMIT_SECONDS=23400

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Uploads ---
# Sized for enterprise camera/drone footage (multi-hour, high-resolution).
# Uploads always stream to disk in 8MB chunks — never buffered fully in
# memory — so this is only a configurable safety cap, not a hard ceiling.
# 0 = unlimited (bounded only by available disk space on the uploads volume).
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=0
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.ts,.mxf,.webm

# --- Database connection pool ---
# Sized for many concurrent dashboard/API/WebSocket clients, as expected in
# a multi-operator, multi-camera deployment.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- Backend process scaling ---
# Number of uvicorn worker processes serving the API (separate from Celery
# worker concurrency above, which handles video processing).
UVICORN_WORKERS=2

# --- Pipeline defaults ---
DEFAULT_CHUNK_SECONDS=30
FRAME_SAMPLE_RATE=5
YOLO_MODEL_PATH=yolov8n.pt
INCIDENT_RISK_THRESHOLD=70.0
INCIDENT_CONSECUTIVE_REQUIRED=3

# --- Frontend (consumed at build/dev time, see frontend/.env.example) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
