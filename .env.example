# Copy to .env and adjust as needed. Used by docker-compose and local dev.

# --- App ---
ENV=development
DEBUG=true

# --- Database (docker-compose service name "postgres") ---
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@postgres:5432/sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# --- Auth / JWT ---
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis / Celery (docker-compose service name "redis") ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv

# --- Pipeline defaults ---
DEFAULT_CHUNK_SECONDS=30
FRAME_SAMPLE_RATE=5
YOLO_MODEL_PATH=yolov8n.pt
INCIDENT_RISK_THRESHOLD=70.0
INCIDENT_CONSECUTIVE_REQUIRED=3

# --- Frontend (consumed at build/dev time, see frontend/.env.example) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
