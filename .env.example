# Copy to .env and adjust as needed. Used by docker-compose and local dev.

# --- App ---
ENV=development
DEBUG=true

# --- Database (docker-compose service name "postgres") ---
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@postgres:5432/sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# --- Auth / JWT ---
# ENV=production refuses to start (app/core/config.py _validate_production_
# safety) if JWT_SECRET is still this default or under 32 characters, or if
# DEBUG is still true -- generate a real secret, e.g. `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis / Celery (docker-compose service name "redis") ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Number of concurrent worker threads per celery_worker container. Each
# concurrently-monitored live camera occupies one of these for the life of
# its session (re-queuing into a fresh slot roughly every
# LIVE_SESSION_MAX_SECONDS), so this must be >= the number of cameras you
# want actively monitored at once, plus headroom for upload-processing
# jobs; a camera beyond that just queues until a slot frees. Scale this
# (and/or run multiple celery_worker replicas) for a larger deployment.
CELERY_WORKER_CONCURRENCY=8
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=21600
CELERY_TASK_TIME_LIMIT_SECONDS=23400

# --- CORS ---
# http://localhost (no port = 80) is required here for the nginx entrypoint:
# the frontend's API base URL is an absolute http://localhost:8000 baked in
# at build time, so a page served via nginx on :80 still calls the backend
# cross-origin, from the browser's perspective, as http://localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Uploads ---
# Sized for enterprise camera/drone footage (multi-hour, high-resolution).
# Uploads always stream to disk in 8MB chunks, never buffered fully in
# memory, so this is only a configurable safety cap, not a hard ceiling.
# 0 = unlimited (bounded only by available disk space on the uploads volume).
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=0
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.ts,.mxf,.webm

# --- Database connection pool ---
# Sized for many concurrent dashboard/API/WebSocket clients, as expected in
# a multi-operator, multi-camera deployment.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- Backend process scaling ---
# Number of uvicorn worker processes serving the API (separate from Celery
# worker concurrency above, which handles video processing).
UVICORN_WORKERS=2

# --- Pipeline defaults ---
DEFAULT_CHUNK_SECONDS=30
FRAME_SAMPLE_RATE=5
YOLO_MODEL_PATH=yolov8n.pt
INCIDENT_RISK_THRESHOLD=70.0
INCIDENT_CONSECUTIVE_REQUIRED=3

# --- Live activity-log generation (app/workers/events.py) ---
# Normalized class names a detection is flagged "weapon"/critical for.
WEAPON_CLASS_NAMES=knife,gun,pistol,rifle,weapon,firearm,grenade,missile
ANOMALY_EVENT_THRESHOLD=0.5
EVENT_HEARTBEAT_SECONDS=3.0

# --- Weapon detection (app/workers/detection.py) ---
# COCO (YOLO_MODEL_PATH above) has no gun/knife classes, so a second,
# dedicated 5-class model (grenade/knife/missile/pistol/rifle) runs
# alongside it, downloaded once from the Hugging Face Hub and cached
# locally. Covers knives; it does NOT cover batons/sticks (no pretrained
# open-source checkpoint for that exists -- see README "Known
# limitations"). Set WEAPON_MODEL_ENABLED=false to disable (e.g. fully
# offline deployments); the pipeline still runs on COCO classes only.
WEAPON_MODEL_ENABLED=true
WEAPON_MODEL_REPO_ID=Dricz/Weapon_Detection_YOLOv8-4
WEAPON_MODEL_FILENAME=50epoch-new-weapon.pt
WEAPON_MODEL_REPO_TYPE=space
WEAPON_MODEL_CONFIDENCE=0.45
WEAPON_MODEL_FALLBACK_CLASS=weapon
# A weapon-class detection within this fraction of the frame diagonal of a
# person track is treated as "held by" that person (app/workers/
# tracking_pipeline.py associate_weapons_to_people): narrated by name
# ("Person #3 appears to be holding a knife") and immediately raised as a
# CRITICAL incident, regardless of zone/rule configuration.
WEAPON_PERSON_ASSOCIATION_MAX_DISTANCE_RATIO=0.25

# --- Real-time alerting (app/services/alert_service.py) ---
# Incidents at or above ALERT_MIN_PRIORITY are sent to email and/or a
# generic webhook (Slack/Discord/PagerDuty/etc. all accept a JSON POST).
# Both are optional and independent; leave both blank to disable delivery
# while keeping incidents/alert_sent tracking in the database. Use
# POST /api/alerts/test (admin only) to verify delivery is configured
# correctly.
ALERT_ENABLED=true
ALERT_MIN_PRIORITY=high
ALERT_COOLDOWN_SECONDS=120
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USE_TLS=true
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@sentinelai.local
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=

# --- Auth rate limiting (app/core/rate_limit.py) ---
# Redis-backed, per-client-IP, fixed-window. Protects against brute-force
# login attempts and registration spam; correct across multiple
# UVICORN_WORKERS processes since the counter lives in Redis.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Frontend (consumed at build/dev time, see frontend/.env.example) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
